# Configure in Timeweb Cloud -> App Platform -> application -> Settings -> Variables.
# Never paste credentials into GitHub, ChatGPT or screenshots.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DB_SSL=1
# For TLS verification via the managed database CA, if needed:
# DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASSWORD=use-app-password
MAIL_FROM=Мои полезные привычки <noreply@example.com>
PUBLIC_ORIGIN=https://your-timeweb-app-domain.twc1.net
PORT=3000
NODE_ENV=production
